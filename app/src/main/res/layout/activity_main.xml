<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="LAB 02: LISTVIEW &amp; RECYCLERVIEW"
            android:textColor="#1976D2"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Chọn bài thực hành bên dưới để kiểm tra:"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Button 1 -->
        <Button
            android:id="@+id/btnCase01"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#2E7D32"
            android:padding="14dp"
            android:text="Bài 1: ListView với mảng dữ liệu định sẵn"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- Button 2 -->
        <Button
            android:id="@+id/btnCase02"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#2E7D32"
            android:padding="14dp"
            android:text="Bài 2: ListView &amp; ArrayList (Thêm / Xóa)"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- Button 3 -->
        <Button
            android:id="@+id/btnCase03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#2E7D32"
            android:padding="14dp"
            android:text="Bài 3: ArrayList &amp; ListView với Object (OOP)"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- Button 4 -->
        <Button
            android:id="@+id/btnCase04"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#2E7D32"
            android:padding="14dp"
            android:text="Bài 4: Custom Adapter cho ListView"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- Button 5 -->
        <Button
            android:id="@+id/btnCase05"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#757575"
            android:padding="14dp"
            android:text="Bài 5: GridView &amp; Spinner (Quản lý món ăn)"
            android:textAllCaps="false"
            android:textSize="15sp" />

        <!-- Button 6 -->
        <Button
            android:id="@+id/btnCase06"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#757575"
            android:padding="14dp"
            android:text="Bài 6: RecyclerView (Nâng cấp từ Bài 4)"
            android:textAllCaps="false"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>